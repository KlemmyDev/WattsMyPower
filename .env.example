# Copy to .env and adjust. All optional - these are the defaults.
# Port the dashboard is served on (http://<this machine>:PORT).
PORT=8080
# Inverters are connected in the dashboard: Settings → Integrations finds them on your network.
# They're stored in data/collector.db. The settings below are only read the first time the collector
# starts, to move an install from before that into the database; leave them empty on a new install.
INVERTER_DRIVER=sungrow.sh_rs
PV2_DRIVER=sungrow.sg_d
# IP address of your Sungrow hybrid inverter's WiNet-S dongle.
INVERTER_HOST=
INVERTER_PORT=502
INVERTER_UNIT=1
# A second, AC-coupled solar system on an older Sungrow string inverter (e.g. SG5K-D) with a Wi-Fi dongle.
PV2_HOST=
PV2_PORT=502
PV2_UNIT=1
# Where a second system connects, unless set in Settings → Integrations: true = on the house side of
# the hybrid's meter, the usual setup (its output is added back to home use); false = outside the
# hybrid's meter (its output counts as exported).
PV2_BEHIND_METER=true
# Seconds between reads. Minimum 60 (lower values are raised to 60).
POLL_INTERVAL=60
# Delete raw snapshots older than N days (5-minute rollups are always kept). 0 = keep forever.
RAW_RETENTION_DAYS=90

# --- collector -- the service that reads the inverters (see collector/PROTOCOL.md) ---
# Secret the dashboard uses to read the collector's feed. install.sh generates one if it's blank.
COLLECTOR_TOKEN=
# Set false on a dashboard following another server's collector (e.g. while developing), so it can't
# connect, remove or scan for that server's inverters.
COLLECTOR_WRITES=true
# Port the collector's feed is published on, for a dashboard running elsewhere (e.g. while developing).
COLLECTOR_PORT=8081
# Keep the collector's raw registers this many days, for `python -m app reprocess`. 0 = keep forever.
COLLECTOR_RETENTION_DAYS=365
TZ=Australia/Brisbane

# --- system ---
# The array size and battery are set in the dashboard: Settings → System. They're stored in
# data/wattsmypower.db. These are only read the first time the dashboard starts, to move an install
# from before that into the database (or to set the array size on a new install without the dashboard).
# Solar array size in kW (the inverter doesn't report it).
PV_KW=6.6
# Battery capacity in kWh. 0 = read it from the inverter. (Backup reserve is read from the inverter too.)
BATTERY_KWH=0

# --- tariffs (AUD) -- starting values; edit them any time in Settings > Tariffs ---
IMPORT_RATE=0.32
FEED_IN_RATE=0.05
SUPPLY_CHARGE=1.05

# --- the house's location, for the forecast, weather, outages and warnings ---
# Chosen in the dashboard (Manage > Integrations > Weather). Nothing that needs it is fetched until it's set.
# LATITUDE=
# LONGITUDE=

# --- sign-in -- the first visit creates the dashboard's account ---
# Set to false only if a reverse proxy in front of the dashboard already handles sign-in.
AUTH=true
