# Copy to .env and adjust. All optional - these are the defaults.
# Port the dashboard is served on (http://<this machine>:PORT).
PORT=8080
# Required: IP address of your Sungrow hybrid inverter's WiNet-S dongle.
INVERTER_HOST=
INVERTER_PORT=502
INVERTER_UNIT=1
# Optional second, AC-coupled solar system on an older Sungrow string inverter (e.g. SG5K-D)
# with a Wi-Fi dongle. Leave empty if you don't have one.
PV2_HOST=
PV2_PORT=502
PV2_UNIT=1
# Where it connects: true = on the house side of the hybrid's meter, the usual setup (its output
# is added back to home use); false = outside the hybrid's meter (its output counts as exported).
PV2_BEHIND_METER=true
# Seconds between reads. Minimum 60 (lower values are raised to 60).
POLL_INTERVAL=60
# Delete raw snapshots older than N days (5-minute rollups are always kept). 0 = keep forever.
RAW_RETENTION_DAYS=90
TZ=Australia/Brisbane

# --- system ---
# Solar array size in kW (the inverter doesn't report it). Used as the forecast's
# starting point; the forecast then calibrates itself against real output.
PV_KW=6.6
# Battery capacity in kWh. 0 = read it from the inverter. (Backup reserve is read from the inverter too.)
BATTERY_KWH=0

# --- tariffs (AUD) -- starting values; edit them any time in Settings > Tariffs ---
IMPORT_RATE=0.32
FEED_IN_RATE=0.05
SUPPLY_CHARGE=1.05

# --- forecast location (Open-Meteo) -- or set it in Settings > Integrations ---
LATITUDE=-27.47
LONGITUDE=153.03

# --- sign-in -- the first visit creates the dashboard's account ---
# Set to false only if a reverse proxy in front of the dashboard already handles sign-in.
AUTH=true
